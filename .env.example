# G Sense environment variables
# Copy to `.env` in the repo root or `artifacts/api-server/.env`.
# Never commit real secrets.

# --- Backend ---
PORT=5000
GEMINI_API_KEY=
GEMINI_MODEL=
DEMO_MODE=false

# Optional PostgreSQL / Supabase. The API uses on-disk environmental memory if this is unset.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Web (Vite) ---
# Leave empty in local dev so the web app uses the Vite `/api` proxy.

# --- Mobile (baked in at Expo/EAS build time) ---
# Do NOT use localhost in a standalone APK.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_DOMAIN=
